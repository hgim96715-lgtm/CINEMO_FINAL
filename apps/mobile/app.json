{
  "expo": {
    "name": "CINEMO",
    "slug": "cinemo",
    "scheme": "cinemo",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "description": "영화 속으로, 추억의 한 장면으로",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101014"
    },
    "ios": {
      "associatedDomains": [
        "applinks:www.cinemo.site"
      ],
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "site.cinemo.app"
    },
    "android": {
      "package": "site.cinemo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101014"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": {
            "scheme": "https",
            "host": "www.cinemo.site",
            "pathPrefix": "/"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.63241350874-9d7o330encrqsdevourf7522hus3f74g"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2d00ecf-34e3-4d8b-9ba1-6e0d75cdb2d5"
      }
    },
    "owner": "hgims-team"
  }
}

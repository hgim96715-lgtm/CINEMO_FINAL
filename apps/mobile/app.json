{
  "expo": {
    "name": "CINEMO",
    "slug": "cinemo",
    "scheme": "cinemo",
    "icon": "./ios/CINEMO/Images.xcassets/AppIcon.appiconset/App-Icon-1024x1024@1x.png",
    "version": "1.0.0",
    "description": "영화 속으로, 추억의 한 장면으로",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b181b",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101014"
    },
    "ios": {
      "associatedDomains": ["applinks:www.cinemo.site"],
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "site.cinemo.app",
      "infoPlist": {
        "NSMotionUsageDescription": "기기의 동작 접근성 설정을 반영해 CINEMO의 화면 전환 효과를 자연스럽게 표시하기 위해 사용해요.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "site.cinemo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101014"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": {
            "scheme": "https",
            "host": "www.cinemo.site",
            "pathPrefix": "/"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 지역 날씨에 맞는 영화를 추천하기 위해 앱 사용 중 위치를 한 번 확인해요.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CINEMO 프로필 사진을 선택하는 데 사진 보관함을 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.63241350874-9d7o330encrqsdevourf7522hus3f74g"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2d00ecf-34e3-4d8b-9ba1-6e0d75cdb2d5"
      }
    },
    "owner": "hgims-team",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/b2d00ecf-34e3-4d8b-9ba1-6e0d75cdb2d5"
    }
  }
}

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum TitleType {
    PRIMARY
    ORIGINAL
    ALIAS
    RERELEASE
}

enum ReleaseType {
    INITIAL
    RERELEASE
}

enum ReleaseStatus {
    ANNOUNCED
    SCHEDULED
    RELEASED
    CANCELLED
}

enum SourceProvider {
    KOBIS
    TMDB
    KMDB
    YOUTUBE
}

enum MatchMethod {
    AUTO
    MANUAL
}

enum MatchStatus {
    PENDING_REVIEW
    APPROVED
    REJECTED
}

enum MediaType {
    POSTER
    BACKDROP
    TRAILER
}

enum MediaStatus {
    ACTIVE
    INACTIVE
}

enum WatchProvider {
    NETFLIX
    WATCHA
    TVING
    DISNEY_PLUS
    WAVVE
    APPLE_TV
}

enum AvailabilityType {
    STREAM
    RENT
    BUY
}

enum CreditType {
    DIRECTOR
    ACTOR
}

enum AuthProvider {
    GOOGLE
    APPLE
    KAKAO
    NAVER
}

enum UserStatus {
    ACTIVE
    SUSPENDED
    DELETED
}

enum EmailVerificationPurpose {
    SIGNUP
    CHANGE_EMAIL
}

enum TermsType {
    SERVICE
    PRIVACY
    MARKETING
}

enum MovieNotificationType {
    RELEASE
}

model User {
    id              String     @id @default(uuid(7)) @db.Uuid
    email           String?    @unique
    nickname        String     @unique
    status          UserStatus @default(ACTIVE)
    profileImageUrl String?    @db.Text
    profileImageKey String?    @db.Text
    lastLoginAt     DateTime?  @db.Timestamptz(3)
    createdAt       DateTime   @default(now()) @db.Timestamptz(3)
    updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

    identities             UserIdentity[]
    passwordCredential     UserPasswordCredential?
    emailVerifications     EmailVerification[]
    passwordResetTokens    PasswordResetToken[]
    termsAgreements        UserTermsAgreement[]
    sessions               AuthSession[]
    userMovieRecords       UserMovieRecord[]
    userMovieNotifications UserMovieNotification[]

    @@index([nickname])
    @@index([status])
    @@map("users")
}

model UserIdentity {
    id               String       @id @default(uuid(7)) @db.Uuid
    userId           String       @db.Uuid
    provider         AuthProvider
    providerUserId   String       @db.Text
    providerEmail    String?
    providerImageUrl String?      @db.Text
    createdAt        DateTime     @default(now()) @db.Timestamptz(3)
    updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerUserId])
    @@index([userId])
    @@map("user_identities")
}

model OauthSignupTicket {
    id               String       @id @default(uuid(7)) @db.Uuid
    tokenHash        String       @unique @db.Text
    provider         AuthProvider
    providerUserId   String       @db.Text
    providerEmail    String?
    providerImageUrl String?      @db.Text
    expiresAt        DateTime     @db.Timestamptz(3)
    consumedAt       DateTime?    @db.Timestamptz(3)
    createdAt        DateTime     @default(now()) @db.Timestamptz(3)

    @@index([provider, providerUserId])
    @@index([expiresAt])
    @@map("oauth_signup_tickets")
}

model UserPasswordCredential {
    id              String    @id @default(uuid(7)) @db.Uuid
    userId          String    @unique @db.Uuid
    passwordHash    String    @db.Text
    emailVerifiedAt DateTime? @db.Timestamptz(3)
    createdAt       DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("user_password_credentials")
}

model EmailVerification {
    id         String                   @id @default(uuid(7)) @db.Uuid
    userId     String                   @db.Uuid
    tokenHash  String                   @unique @db.Text
    purpose    EmailVerificationPurpose
    expiresAt  DateTime                 @db.Timestamptz(3)
    verifiedAt DateTime?                @db.Timestamptz(3)
    createdAt  DateTime                 @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, purpose])
    @@index([expiresAt])
    @@map("email_verifications")
}

model PasswordResetToken {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    tokenHash String    @unique @db.Text
    expiresAt DateTime  @db.Timestamptz(3)
    usedAt    DateTime? @db.Timestamptz(3)
    createdAt DateTime  @default(now()) @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@map("password_reset_tokens")
}

model UserTermsAgreement {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    termsType TermsType
    version   String    @db.VarChar(30)
    agreedAt  DateTime  @default(now()) @db.Timestamptz(3)
    ipAddress String?   @db.VarChar(45)
    userAgent String?   @db.Text

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, termsType, agreedAt])
    @@map("user_terms_agreements")
}

model AuthSession {
    id        String    @id @default(uuid(7)) @db.Uuid
    userId    String    @db.Uuid
    tokenHash String    @unique @db.Text
    expiresAt DateTime  @db.Timestamptz(3)
    revokedAt DateTime? @db.Timestamptz(3)
    userAgent String?   @db.Text
    ipAddress String?   @db.VarChar(45)
    createdAt DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt DateTime  @updatedAt @db.Timestamptz(3)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, expiresAt])
    @@index([expiresAt])
    @@map("auth_sessions")
}

model UserMovieRecord {
    id         String    @id @default(uuid(7)) @db.Uuid
    userId     String    @db.Uuid
    movieId    String    @db.Uuid
    isFavorite Boolean   @default(false)
    watchedAt  DateTime? @db.Timestamptz(3)
    rating     Decimal?  @db.Decimal(2, 1)
    createdAt  DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([userId, movieId])
    @@index([userId, isFavorite])
    @@index([userId, watchedAt])
    @@map("user_movie_records")
}

model UserMovieNotification {
    id               String                @id @default(uuid(7)) @db.Uuid
    userId           String                @db.Uuid
    movieId          String                @db.Uuid
    releaseId        String?               @db.Uuid
    notificationType MovieNotificationType
    enabled          Boolean               @default(true)
    notifiedAt       DateTime?             @db.Timestamptz(3)
    createdAt        DateTime              @default(now()) @db.Timestamptz(3)
    updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

    user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
    release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

    @@unique([userId, movieId, notificationType])
    @@index([movieId, notificationType, enabled])
    @@index([releaseId])
    @@map("user_movie_notifications")
}

model Movie {
    id                     String   @id @default(uuid(7)) @db.Uuid
    createdAt              DateTime @default(now()) @db.Timestamptz(3)
    updatedAt              DateTime @updatedAt @db.Timestamptz(3)
    productionCountryCodes String[] @default([]) @map("production_country_codes")

    overview        String?  @db.Text
    runtime         Int?
    tmdbVoteAverage Decimal? @db.Decimal(3, 1)
    tmdbVoteCount   Int?

    titles                 MovieTitle[]
    releases               MovieRelease[]
    providerLinks          MovieProviderLink[]
    media                  MovieMedia[]
    watchOptions           MovieWatchOption[]
    rankingSnapshots       MovieRankingSnapshot[]
    popularitySnapshots    MoviePopularitySnapshot[]
    movieCredits           MovieCredit[]
    movieGenres            MovieGenre[]
    movieCertifications    MovieCertification[]
    userMovieRecords       UserMovieRecord[]
    userMovieNotifications UserMovieNotification[]

    @@map("movies")
}

model MovieTitle {
    id           String    @id @default(uuid(7)) @db.Uuid
    movieId      String    @db.Uuid
    releaseId    String?   @db.Uuid
    title        String    @db.Text
    titleType    TitleType
    languageCode String?   @db.VarChar(10)
    createdAt    DateTime  @default(now()) @db.Timestamptz(3)
    updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

    movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
    release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

    @@index([movieId, titleType])
    @@index([releaseId])
    @@map("movie_titles")
}

model MovieRelease {
    id          String        @id @default(uuid(7)) @db.Uuid
    movieId     String        @db.Uuid
    releaseDate DateTime?     @db.Date
    releaseType ReleaseType
    status      ReleaseStatus
    countryCode String?       @db.Char(2)
    isPrimary   Boolean       @default(false)
    createdAt   DateTime      @default(now()) @db.Timestamptz(3)
    updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

    movie                  Movie                   @relation(fields: [movieId], references: [id], onDelete: Cascade)
    titles                 MovieTitle[]
    movieMedias            MovieMedia[]
    userMovieNotifications UserMovieNotification[]

    @@index([movieId, isPrimary])
    @@index([status, releaseDate])
    @@map("movie_releases")
}

model MovieProviderLink {
    id             String         @id @default(uuid(7)) @db.Uuid
    movieId        String         @db.Uuid
    sourceProvider SourceProvider
    externalId     String         @db.Text
    matchMethod    MatchMethod
    matchStatus    MatchStatus    @default(PENDING_REVIEW)
    confidence     Decimal?       @db.Decimal(5, 4)
    verifiedAt     DateTime?      @db.Timestamptz(3)
    createdAt      DateTime       @default(now()) @db.Timestamptz(3)
    updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([sourceProvider, externalId])
    @@index([movieId, matchStatus])
    @@map("movie_provider_links")
}

model MovieMedia {
    id             String         @id @default(uuid(7)) @db.Uuid
    movieId        String         @db.Uuid
    releaseId      String?        @db.Uuid
    mediaType      MediaType
    sourceProvider SourceProvider
    url            String         @db.Text
    externalId     String?        @db.Text
    isPrimary      Boolean        @default(false)
    status         MediaStatus    @default(ACTIVE)
    verifiedAt     DateTime?      @db.Timestamptz(3)
    createdAt      DateTime       @default(now()) @db.Timestamptz(3)
    updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

    movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
    release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

    @@index([movieId, mediaType, isPrimary])
    @@index([releaseId])
    @@map("movie_media")
}

model MovieWatchOption {
    id               String           @id @default(uuid(7)) @db.Uuid
    movieId          String           @db.Uuid
    watchProvider    WatchProvider
    availabilityType AvailabilityType
    regionCode       String           @default("KR") @db.VarChar(10)
    url              String           @db.Text
    expiresAt        DateTime?        @db.Timestamptz(3)
    lastVerifiedAt   DateTime?        @db.Timestamptz(3)
    createdAt        DateTime         @default(now()) @db.Timestamptz(3)
    updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@index([movieId, regionCode])
    @@index([watchProvider, availabilityType])
    @@map("movie_watch_options")
}

model MovieRankingSnapshot {
    id                 String         @id @default(uuid(7)) @db.Uuid
    movieId            String         @db.Uuid
    sourceProvider     SourceProvider
    rank               Int
    rankChange         Int?
    audienceCount      Int?
    totalAudienceCount Int?
    collectedAt        DateTime       @db.Timestamptz(3)
    createdAt          DateTime       @default(now()) @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@index([sourceProvider, collectedAt, rank])
    @@index([movieId, collectedAt])
    @@map("movie_ranking_snapshots")
}

model MoviePopularitySnapshot {
    id          String   @id @default(uuid(7)) @db.Uuid
    movieId     String   @db.Uuid
    rank        Int
    collectedAt DateTime @db.Timestamptz(3)
    createdAt   DateTime @default(now()) @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@index([collectedAt, rank])
    @@index([movieId, collectedAt])
    @@map("movie_popularity_snapshots")
}

model MoviePerson {
    id        String   @id @default(uuid(7)) @db.Uuid
    name      String   @db.Text
    nameEn    String?  @db.Text
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    credits       MovieCredit[]
    providerLinks MoviePersonProviderLink[]

    @@index([name])
    @@index([nameEn])
    @@map("movie_people")
}

model MoviePersonProviderLink {
    id             String         @id @default(uuid(7)) @db.Uuid
    personId       String         @db.Uuid
    sourceProvider SourceProvider
    externalId     String         @db.Text
    createdAt      DateTime       @default(now()) @db.Timestamptz(3)

    person MoviePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

    @@unique([sourceProvider, externalId])
    @@index([personId])
    @@map("movie_person_provider_links")
}

model MovieCredit {
    id            String     @id @default(uuid(7)) @db.Uuid
    movieId       String     @db.Uuid
    personId      String     @db.Uuid
    creditType    CreditType
    characterName String?    @db.Text
    displayOrder  Int?
    createdAt     DateTime   @default(now()) @db.Timestamptz(3)

    movie  Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
    person MoviePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

    @@unique([movieId, personId, creditType])
    @@index([personId, creditType])
    @@index([movieId, creditType])
    @@map("movie_credits")
}

model MovieGenre {
    id        String   @id @default(uuid(7)) @db.Uuid
    movieId   String   @db.Uuid
    code      String?  @db.VarChar(50)
    name      String   @db.VarChar(100)
    createdAt DateTime @default(now()) @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([movieId, name])
    @@index([name])
    @@index([code])
    @@map("movie_genres")
}

model MovieCertification {
    id             String         @id @default(uuid(7)) @db.Uuid
    movieId        String         @db.Uuid
    auditNo        String         @db.Text
    watchGradeName String         @db.VarChar(100)
    sourceProvider SourceProvider
    verifiedAt     DateTime?      @db.Timestamptz(3)
    createdAt      DateTime       @default(now()) @db.Timestamptz(3)
    updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

    movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([sourceProvider, auditNo])
    @@index([movieId])
    @@map("movie_certifications")
}

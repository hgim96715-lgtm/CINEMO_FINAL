generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TitleType {
  PRIMARY
  ORIGINAL
  ALIAS
  RERELEASE
}

enum ReleaseType {
  INITIAL
  RERELEASE
}

enum ReleaseStatus {
  ANNOUNCED
  SCHEDULED
  RELEASED
  CANCELLED
}

enum SourceProvider {
  KOBIS
  TMDB
  KMDB
  YOUTUBE
}

enum MatchMethod {
  AUTO
  MANUAL
}

enum MatchStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum MediaType {
  POSTER
  BACKDROP
  TRAILER
}

enum MediaStatus {
  ACTIVE
  INACTIVE
}

enum WatchProvider {
  NETFLIX
  WATCHA
  TVING
  DISNEY_PLUS
  WAVVE
  APPLE_TV
  PRIME_VIDEO
}

enum AvailabilityType {
  STREAM
  RENT
  BUY
}

enum CreditType {
  DIRECTOR
  ACTOR
}

enum AuthProvider {
  GOOGLE
  APPLE
  KAKAO
  NAVER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserVisibility {
  PUBLIC
  PRIVATE
}

enum EmailVerificationPurpose {
  SIGNUP
  CHANGE_EMAIL
}

enum TermsType {
  SERVICE
  PRIVACY
  MARKETING
}

enum MovieNotificationType {
  RELEASE
}

enum MovieVisibility {
  PUBLIC
  REVIEW
  HIDDEN
}

enum MapProvider {
  KAKAO
}

enum VenueType {
  CINEMA
  HOME
  MUSEUM
  EXHIBITION_HALL
  PERFORMANCE_HALL
  OTHER
}

enum ViewingPlaceType {
  HOME
  VENUE
}

enum ViewingPlatform {
  NETFLIX
  WATCHA
  TVING
  DISNEY_PLUS
  WAVVE
  APPLE_TV
  PRIME_VIDEO
  COUPANG_PLAY
  TV
  OTHER
}

enum MovieSyncJobType {
  INITIAL_IMPORT
  DAILY_RANKING
  UPCOMINT_RELEASES
  MOVIE_ENTICHMENT
  WATCH_PROVIDER_REFRESH
}

enum MovieSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum PostcardCommentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum PostcardNotificationType {
  COMMENT
  REPLY
  REACTION
  MENTION
}

enum PostcardRestrictionType {
  COMMENT
  INTERACTION
  ALL
}

enum PostcardType {
  REVIEW
  QUOTE
  SCENE
}

enum PostcardSource {
  USER
  AI
}

enum PostcardQuoteSource {
  USER
  OPENSUBTITLES
}

enum PostcardVisibility {
  PUBLIC
  PRIVATE
}

enum PostcardStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum PostcardGenerationStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PostcardReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum PostcardModerationAction {
  HIDE
  RESTORE
  DELETE
  WARN
  RESTRICT_USER
}

enum PostcardMediaType {
  IMAGE
}

enum PushTokenPlatform {
  IOS     // iOS 기기에서 발급된 Expo Push Token
  ANDROID // Android 기기에서 발급된 Expo Push Token
}

enum UserActivityType {
  LOGIN
  LOGOUT
  MOVIE_RECORD_UPSERT
  MOVIE_RECORD_DELETE
  MOVIE_NOTIFICATION_SUBSCRIBE
  MOVIE_NOTIFICATION_UNSUBSCRIBE
  CINEMA_VISIT_CREATE
  CINEMA_VISIT_DELETE
  POSTCARD_CREATE
  POSTCARD_UPDATE
  POSTCARD_PUBLISH
  POSTCARD_DELETE
  POSTCARD_COMMENT_CREATE
  POSTCARD_REACTION_ADD
  POSTCARD_REACTION_REMOVE
  POSTCARD_BOOKMARK_ADD
  POSTCARD_BOOKMARK_REMOVE
  PERSON_BOOKMARK_ADD
  PERSON_BOOKMARK_REMOVE
}

model Postcard {
  id                 String               @id @default(uuid(7)) @db.Uuid
  userId             String               @db.Uuid
  movieId            String               @db.Uuid
  type               PostcardType
  source             PostcardSource       @default(USER)
  quoteSource        PostcardQuoteSource? @map("quote_source") // QUOTE 원문의 근거
  content            String               @db.Text
  backgroundStyle    String?              @map("background_style") @db.VarChar(100)
  backgroundImageKey String?              @map("background_image_key") @db.VarChar(255)
  style              Json?
  metadata           Json?
  visibility         PostcardVisibility   @default(PRIVATE)
  status             PostcardStatus       @default(DRAFT)

  reactionCount Int @default(0) @map("reaction_count")
  commentCount  Int @default(0) @map("comment_count")
  shareCount    Int @default(0) @map("share_count")

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie         Movie                  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  media         PostcardMedia[]
  revisions     PostcardRevision[]
  reactions     PostcardReaction[]
  comments      PostcardComment[]
  bookmarks     PostcardBookmark[]
  shares        PostcardShare[]
  reports       PostcardReport[]
  moderations   PostcardModeration[]
  generations   PostcardGeneration[]
  notifications PostcardNotification[]

  @@index([userId, status, createdAt])
  @@index([movieId, visibility, status, createdAt])
  @@index([visibility, status, publishedAt])
  @@map("postcards")
}

model PostcardRevision {
  id         String         @id @default(uuid(7)) @db.Uuid
  postcardId String         @db.Uuid
  version    Int
  content    String         @db.Text
  source     PostcardSource
  editorId   String?        @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  editor   User?    @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([postcardId, version])
  @@index([postcardId, createdAt])
  @@map("postcard_revisions")
}

model PostcardReaction {
  postcardId String   @db.Uuid
  userId     String   @db.Uuid
  emoji      String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postcardId, userId, emoji])
  @@index([postcardId, emoji, createdAt])
  @@index([userId, createdAt])
  @@map("postcard_reactions")
}

model PostcardBookmark {
  postcardId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postcardId, userId])
  @@index([userId, createdAt])
  @@map("postcard_bookmarks")
}

model PostcardComment {
  id            String                @id @default(uuid(7)) @db.Uuid
  postcardId    String                @db.Uuid
  userId        String                @db.Uuid
  parentId      String?               @db.Uuid
  content       String                @db.Text
  status        PostcardCommentStatus @default(PUBLISHED)
  reactionCount Int                   @default(0)
  replyCount    Int                   @default(0)
  deletedAt     DateTime?             @map("deleted_at") @db.Timestamptz(3)
  editedAt      DateTime?             @map("edited_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  postcard      Postcard                  @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        PostcardComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       PostcardComment[]         @relation("CommentReplies")
  reactions     PostcardCommentReaction[]
  notifications PostcardNotification[]

  @@index([postcardId, status, createdAt])
  @@index([postcardId, parentId, status, createdAt])
  @@index([postcardId, userId, createdAt])
  @@map("postcard_comments")
}

model PostcardCommentReaction {
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment PostcardComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, emoji])
  @@index([commentId, emoji, createdAt])
  @@index([userId, createdAt])
  @@map("postcard_comment_reactions")
}

model PostcardNotification {
  id            String                   @id @default(uuid(7)) @db.Uuid
  recipientId   String                   @db.Uuid
  actorId       String?                  @db.Uuid
  postcardId    String?                  @db.Uuid
  commentId     String?                  @db.Uuid
  type          PostcardNotificationType
  reactionEmoji String?                  @map("reaction_emoji") @db.VarChar(64)
  readAt        DateTime?                @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User             @relation("PostcardNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?            @relation("PostcardNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  postcard  Postcard?        @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  comment   PostcardComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([postcardId, createdAt])
  @@map("postcard_notifications")
}

model PostcardShare {
  id         String   @id @default(uuid(7)) @db.Uuid
  postcardId String   @db.Uuid
  userId     String?  @db.Uuid
  channel    String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postcardId, createdAt])
  @@index([userId, createdAt])
  @@map("postcard_shares")
}

model PostcardReport {
  id         String               @id @default(uuid(7)) @db.Uuid
  postcardId String               @db.Uuid
  reporterId String               @db.Uuid
  reason     String               @db.Text
  status     PostcardReportStatus @default(PENDING)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?            @map("resolved_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postcardId, status, createdAt])
  @@index([reporterId, createdAt])
  @@map("postcard_reports")
}

model PostcardModeration {
  id          String                   @id @default(uuid(7)) @db.Uuid
  postcardId  String                   @db.Uuid
  moderatorId String                   @db.Uuid
  action      PostcardModerationAction
  reason      String?                  @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard  Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)
  moderator User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([postcardId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("postcard_moderations")
}

model PostcardUserRestriction {
  id        String                  @id @default(uuid(7)) @db.Uuid
  userId    String                  @db.Uuid
  type      PostcardRestrictionType
  reason    String?                 @db.Text
  startsAt  DateTime                @default(now()) @map("starts_at") @db.Timestamptz(3)
  expiresAt DateTime?               @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?               @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, revokedAt, expiresAt])
  @@index([createdAt])
  @@map("postcard_user_restrictions")
}

model PostcardGeneration {
  id            String                   @id @default(uuid(7)) @db.Uuid
  postcardId    String?                  @db.Uuid
  userId        String                   @db.Uuid
  movieId       String                   @db.Uuid
  type          PostcardType
  model         String                   @db.VarChar(100)
  promptVersion String                   @map("prompt_version") @db.VarChar(100)
  inputSummary  String?                  @map("input_summary") @db.Text
  outputContent String?                  @map("output_content") @db.Text
  status        PostcardGenerationStatus @default(REQUESTED)
  errorMessage  String?                  @map("error_message") @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?                @map("completed_at") @db.Timestamptz(3)

  postcard Postcard? @relation(fields: [postcardId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie    Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([movieId, status, createdAt])
  @@map("postcard_generations")
}

model PostcardPolicy {
  id                        String   @id @default(uuid(7)) @db.Uuid
  name                      String   @unique @db.VarChar(100)
  dailyCreateLimit          Int      @map("daily_create_limit")
  movieDailyLimit           Int      @map("movie_daily_limit")
  aiDailyLimit              Int      @map("ai_daily_limit")
  maxContentLength          Int      @map("max_content_length")
  commentMaxLength          Int      @map("comment_max_length")
  commentRateLimitCount     Int      @map("comment_rate_limit_count")
  commentRateLimitWindowSec Int      @map("comment_rate_limit_window_sec")
  duplicateCommentWindowSec Int      @map("duplicate_comment_window_sec")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("postcard_policies")
}

model PostcardDailyUsage {
  userId      String   @db.Uuid
  movieId     String   @db.Uuid
  usageDate   DateTime @db.Date
  totalCount  Int      @default(0) @map("total_count")
  reviewCount Int      @default(0) @map("review_count")
  aiCount     Int      @default(0) @map("ai_count")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId, usageDate])
  @@index([userId, usageDate])
  @@map("postcard_daily_usages")
}

model PostcardMedia {
  id         String            @id @default(uuid(7)) @db.Uuid
  postcardId String            @db.Uuid
  type       PostcardMediaType
  url        String?           @db.VarChar(2048)
  storageKey String?           @map("storage_key") @db.VarChar(512)
  altText    String?           @map("alt_text") @db.VarChar(500)
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  postcard Postcard @relation(fields: [postcardId], references: [id], onDelete: Cascade)

  @@index([postcardId, sortOrder, createdAt])
  @@map("postcard_media")
}

model MovieSyncRun {
  id             String           @id @default(uuid(7)) @db.Uuid
  jobType        MovieSyncJobType
  status         MovieSyncStatus
  currentPage    Int              @default(1)
  currentCursor  String?
  processedCount Int              @default(0)
  successCount   Int              @default(0)
  failureCount   Int              @default(0)
  errorMessage   String?          @db.Text
  startedAt      DateTime         @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?        @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@index([jobType, status])
  @@index([startedAt])
  @@map("movie_sync_runs")
}

model User {
  id                String         @id @default(uuid(7)) @db.Uuid
  email             String?        @unique
  nickname          String         @unique
  status            UserStatus     @default(ACTIVE)
  profileVisibility UserVisibility @default(PUBLIC) @map("profile_visibility")
  isAdmin           Boolean        @default(false)
  profileImageUrl   String?        @db.Text
  profileImageKey   String?        @db.Text
  lastLoginAt       DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  identities                 UserIdentity[]
  passwordCredential         UserPasswordCredential?
  emailVerifications         EmailVerification[]
  passwordResetTokens        PasswordResetToken[]
  termsAgreements            UserTermsAgreement[]
  sessions                   AuthSession[]
  userMovieRecords           UserMovieRecord[]
  userMovieNotifications     UserMovieNotification[]
  userPersonBookmarks        UserPersonBookmark[]
  postcards                  Postcard[]
  postcardRevisions          PostcardRevision[]
  postcardReactions          PostcardReaction[]
  postcardCommentReactions   PostcardCommentReaction[]
  postcardComments           PostcardComment[]
  postcardBookmarks          PostcardBookmark[]
  postcardShares             PostcardShare[]
  postcardReports            PostcardReport[]
  postcardModerations        PostcardModeration[]
  postcardRestrictions       PostcardUserRestriction[]
  postcardGenerations        PostcardGeneration[]
  postcardDailyUsages        PostcardDailyUsage[]
  postcardNotifications      PostcardNotification[]    @relation("PostcardNotificationRecipient")
  postcardNotificationActors PostcardNotification[]    @relation("PostcardNotificationActor")
  mobileRefreshTokens        MobileRefreshToken[]
  pushTokens                 PushToken[]                 // 사용자의 기기별 푸시 토큰
  activityLogs               UserActivityLog[]

  @@index([nickname])
  @@index([status])
  @@map("users")
}

model UserActivityLog {
  id         String           @id @default(uuid(7)) @db.Uuid // 활동 로그 식별자
  userId     String           @db.Uuid // 활동을 수행한 사용자
  type       UserActivityType // 수행한 활동 종류
  targetType String?          @map("target_type") @db.VarChar(50) // 활동 대상 종류
  targetId   String?          @map("target_id") @db.Uuid // 활동 대상 식별자
  metadata   Json? // 화면에 표시할 부가 정보
  createdAt  DateTime         @default(now()) @db.Timestamptz(3) // 활동 발생 시각

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("user_activity_logs")
}

model PushToken {
  id         String            @id @default(uuid(7)) @db.Uuid // 푸시 토큰 레코드 식별자
  userId     String            @db.Uuid                    // 토큰을 발급받은 사용자
  token      String            @unique @db.Text             // Expo Push Token 원문
  platform   PushTokenPlatform                              // 토큰이 발급된 모바일 플랫폼
  lastUsedAt DateTime          @default(now()) @map("last_used_at") @db.Timestamptz(3) // 마지막 등록·갱신 시각
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3) // 생성 시각
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3) // 수정 시각

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // 사용자 삭제 시 토큰도 삭제

  @@index([userId, platform]) // 사용자·플랫폼별 조회 최적화
  @@map("push_tokens")       // PostgreSQL 테이블명
}

model UserIdentity {
  id               String       @id @default(uuid(7)) @db.Uuid
  userId           String       @db.Uuid
  provider         AuthProvider
  providerUserId   String       @db.Text
  providerEmail    String?
  providerImageUrl String?      @db.Text
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_identities")
}

model OauthSignupTicket {
  id               String       @id @default(uuid(7)) @db.Uuid
  tokenHash        String       @unique @db.Text
  provider         AuthProvider
  providerUserId   String       @db.Text
  providerEmail    String?
  providerImageUrl String?      @db.Text
  expiresAt        DateTime     @db.Timestamptz(3)
  consumedAt       DateTime?    @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)

  @@index([provider, providerUserId])
  @@index([expiresAt])
  @@map("oauth_signup_tickets")
}

model UserPasswordCredential {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @db.Uuid
  passwordHash    String    @db.Text
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_credentials")
}

model EmailVerification {
  id         String                   @id @default(uuid(7)) @db.Uuid
  userId     String                   @db.Uuid
  tokenHash  String                   @unique @db.Text
  purpose    EmailVerificationPurpose
  expiresAt  DateTime                 @db.Timestamptz(3)
  verifiedAt DateTime?                @db.Timestamptz(3)
  createdAt  DateTime                 @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Text
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserTermsAgreement {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  termsType TermsType
  version   String    @db.VarChar(30)
  agreedAt  DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, termsType, agreedAt])
  @@map("user_terms_agreements")
}

model AuthSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Text
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  userAgent String?   @db.Text
  ipAddress String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserMovieRecord {
  id                    String            @id @default(uuid(7)) @db.Uuid
  userId                String            @db.Uuid
  movieId               String            @db.Uuid
  venueId               String?           @map("venue_id") @db.Uuid
  viewingPlaceType      ViewingPlaceType?
  viewingPlatform       ViewingPlatform?
  viewingPlatformCustom String?           @map("viewing_platform_custom") @db.VarChar(100)
  isFavorite            Boolean           @default(false)
  watchedAt             DateTime?         @db.Timestamptz(3)
  rating                Decimal?          @db.Decimal(2, 1)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([userId, movieId])
  @@index([userId, isFavorite])
  @@index([userId, watchedAt])
  @@index([userId, venueId])
  @@map("user_movie_records")
}

model Venue {
  id         String       @id @default(uuid(7)) @db.Uuid
  type       VenueType    @default(OTHER)
  provider   MapProvider?
  externalId String?      @map("external_id") @db.Text

  name      String  @db.Text
  brandName String? @map("brand_name") @db.Text

  region1Code String? @map("region1_code") @db.Text
  region1Name String? @map("region1_name") @db.Text
  region2Code String? @map("region2_code") @db.Text
  region2Name String? @map("region2_name") @db.Text
  region3Code String? @map("region3_code") @db.Text
  region3Name String? @map("region3_name") @db.Text

  hCode String? @map("h_code") @db.VarChar(10)
  bCode String? @map("b_code") @db.VarChar(10)

  roadAddress  String? @map("road_address") @db.Text
  jibunAddress String? @map("jibun_address") @db.Text

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  phone    String? @db.Text
  placeUrl String? @map("place_url") @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  userMovieRecords UserMovieRecord[]

  @@unique([provider, externalId])
  @@index([type])
  @@index([type, isActive, region1Code, region2Code, region3Code])
  @@index([region1Code, region2Code, region3Code])
  @@index([name])
  @@index([brandName])
  @@index([hCode])
  @@index([bCode])
  @@map("venues")
}

model UserPersonBookmark {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  personId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  person MoviePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([personId])
  @@map("user_person_bookmarks")
}

model UserMovieNotification {
  id               String                @id @default(uuid(7)) @db.Uuid
  userId           String                @db.Uuid
  movieId          String                @db.Uuid
  releaseId        String?               @db.Uuid
  notificationType MovieNotificationType
  enabled          Boolean               @default(true)
  dayBeforeNotifiedAt DateTime?          @db.Timestamptz(3) @map("day_before_notified_at")
  notifiedAt       DateTime?             @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@unique([userId, movieId, notificationType])
  @@index([movieId, notificationType, enabled])
  @@index([releaseId])
  @@map("user_movie_notifications")
}

model Movie {
  id                     String          @id @default(uuid(7)) @db.Uuid
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  productionCountryCodes String[]        @default([]) @map("production_country_codes")
  visibility             MovieVisibility @default(PUBLIC)
  moderationReason       String?         @db.Text
  reviewedAt             DateTime?       @db.Timestamptz(3)

  overview        String?  @db.Text
  runtime         Int?
  tmdbVoteAverage Decimal? @db.Decimal(3, 1)
  tmdbVoteCount   Int?

  titles                 MovieTitle[]
  releases               MovieRelease[]
  providerLinks          MovieProviderLink[]
  media                  MovieMedia[]
  watchOptions           MovieWatchOption[]
  rankingSnapshots       MovieRankingSnapshot[]
  popularitySnapshots    MoviePopularitySnapshot[]
  movieCredits           MovieCredit[]
  movieGenres            MovieGenre[]
  movieCertifications    MovieCertification[]
  userMovieRecords       UserMovieRecord[]
  userMovieNotifications UserMovieNotification[]
  postcards              Postcard[]
  postcardGenerations    PostcardGeneration[]
  postcardDailyUsages    PostcardDailyUsage[]

  @@index([visibility])
  @@map("movies")
}

model MovieTitle {
  id           String    @id @default(uuid(7)) @db.Uuid
  movieId      String    @db.Uuid
  releaseId    String?   @db.Uuid
  title        String    @db.Text
  titleType    TitleType
  languageCode String?   @db.VarChar(10)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([movieId, titleType])
  @@index([releaseId])
  @@map("movie_titles")
}

model MovieRelease {
  id          String        @id @default(uuid(7)) @db.Uuid
  movieId     String        @db.Uuid
  releaseDate DateTime?     @db.Date
  releaseType ReleaseType
  status      ReleaseStatus
  countryCode String?       @db.Char(2)
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  movie                  Movie                   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  titles                 MovieTitle[]
  movieMedias            MovieMedia[]
  userMovieNotifications UserMovieNotification[]

  @@index([movieId, isPrimary])
  @@index([status, releaseDate])
  @@map("movie_releases")
}

model MovieProviderLink {
  id             String         @id @default(uuid(7)) @db.Uuid
  movieId        String         @db.Uuid
  sourceProvider SourceProvider
  externalId     String         @db.Text
  matchMethod    MatchMethod
  matchStatus    MatchStatus    @default(PENDING_REVIEW)
  confidence     Decimal?       @db.Decimal(5, 4)
  verifiedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([sourceProvider, externalId])
  @@index([movieId, matchStatus])
  @@map("movie_provider_links")
}

model MovieMedia {
  id             String         @id @default(uuid(7)) @db.Uuid
  movieId        String         @db.Uuid
  releaseId      String?        @db.Uuid
  mediaType      MediaType
  sourceProvider SourceProvider
  url            String         @db.Text
  externalId     String?        @db.Text
  isPrimary      Boolean        @default(false)
  status         MediaStatus    @default(ACTIVE)
  verifiedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  movie   Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  release MovieRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([movieId, mediaType, isPrimary])
  @@index([releaseId])
  @@map("movie_media")
}

model MovieWatchOption {
  id               String           @id @default(uuid(7)) @db.Uuid
  movieId          String           @db.Uuid
  tmdbProviderId   Int?             @map("tmdb_provider_id")
  watchProvider    WatchProvider
  availabilityType AvailabilityType
  logoPath         String?          @map("logo_path") @db.VarChar(255)
  regionCode       String           @default("KR") @db.VarChar(10)
  url              String           @db.Text
  expiresAt        DateTime?        @db.Timestamptz(3)
  lastVerifiedAt   DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId, regionCode])
  @@index([watchProvider, availabilityType])
  @@index([tmdbProviderId, regionCode])
  @@map("movie_watch_options")
}

model MovieRankingSnapshot {
  id                 String         @id @default(uuid(7)) @db.Uuid
  movieId            String         @db.Uuid
  sourceProvider     SourceProvider
  rank               Int
  rankChange         Int?
  audienceCount      Int?
  totalAudienceCount Int?
  collectedAt        DateTime       @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([sourceProvider, collectedAt, rank])
  @@index([movieId, collectedAt])
  @@map("movie_ranking_snapshots")
}

model MoviePopularitySnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  movieId     String   @db.Uuid
  rank        Int
  collectedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([collectedAt, rank])
  @@index([movieId, collectedAt])
  @@map("movie_popularity_snapshots")
}

model MoviePerson {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String    @db.Text
  nameEn         String?   @db.Text
  profileUrl     String?   @db.Text
  biography      String?   @db.Text
  birthDate      DateTime? @db.Date
  birthPlace     String?   @db.Text
  nationality    String?   @db.Text
  tmdbEnrichedAt DateTime? @map("tmdb_enriched_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  credits             MovieCredit[]
  providerLinks       MoviePersonProviderLink[]
  userPersonBookmarks UserPersonBookmark[]

  @@index([name])
  @@index([nameEn])
  @@index([tmdbEnrichedAt])
  @@map("movie_people")
}

model MoviePersonProviderLink {
  id             String         @id @default(uuid(7)) @db.Uuid
  personId       String         @db.Uuid
  sourceProvider SourceProvider
  externalId     String         @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  person MoviePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([sourceProvider, externalId])
  @@index([personId])
  @@map("movie_person_provider_links")
}

model MovieCredit {
  id            String     @id @default(uuid(7)) @db.Uuid
  movieId       String     @db.Uuid
  personId      String     @db.Uuid
  creditType    CreditType
  characterName String?    @db.Text
  displayOrder  Int?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  movie  Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person MoviePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([movieId, personId, creditType])
  @@index([personId, creditType])
  @@index([movieId, creditType])
  @@map("movie_credits")
}

model MovieGenre {
  id        String   @id @default(uuid(7)) @db.Uuid
  movieId   String   @db.Uuid
  code      String?  @db.VarChar(50)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, name])
  @@index([name])
  @@index([code])
  @@map("movie_genres")
}

model MovieCertification {
  id             String         @id @default(uuid(7)) @db.Uuid
  movieId        String         @db.Uuid
  auditNo        String         @db.Text
  watchGradeName String         @db.VarChar(100)
  sourceProvider SourceProvider
  verifiedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([sourceProvider, auditNo])
  @@index([movieId])
  @@map("movie_certifications")
}

// Mobile
model MobileRefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Text
  deviceId   String?   @db.VarChar(100)
  userAgent  String?   @db.Text
  ipAddress  String?   @db.VarChar(45)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("mobile_refresh_tokens")
}
